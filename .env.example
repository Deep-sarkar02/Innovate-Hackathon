# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Frontend (Vite) ──────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai-sales-copilot

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── LiveKit Cloud ────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ── AI Services ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
DEEPGRAM_API_KEY=your-deepgram-key

# ── Sarvam AI (Indian TTS + STT — Bulbul v3 / Saaras v4) ──
SARVAM_API_KEY=sk_your-sarvam-key

# ── Kimi K3 (Moonshot — primary text brain; voice via Sarvam) ──
KIMI_API_KEY=sk-your-kimi-key
KIMI_MODEL=kimi-k3

# ── Amazon Bedrock (fallback text brain) ──
# Optional: Amazon Polly TTS + Amazon Transcribe STT (requires IAM keys — Bedrock API key alone does NOT work for voice)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_API_KEY=bedrock-api-key-...
AWS_REGION=us-west-2
BEDROCK_MODEL=mistral.mistral-large-3-675b-instruct

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
